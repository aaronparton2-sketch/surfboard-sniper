# Surfboard Sniper — example environment
# Copy to .env and fill in. NONE of these are needed to run `node src/demo.js`
# (the demo is fully offline). They are only needed for the live n8n pipeline,
# where you'd normally store them as n8n credentials rather than a .env file.

# Apify token (apify.com -> Settings -> Integrations -> API token)
APIFY_TOKEN=

# Supabase project (Project Settings -> API)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Telegram bot (talk to @BotFather to create one) and the chat to alert.
# Get your chat id by messaging the bot then visiting
# https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
